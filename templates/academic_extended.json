{
  "id": "academic_extended",
  "name": "Academic Extended CV",
  "version": "1.0.0",
  "family": "dates-in-margin academic",
  "description": "Complete academic CV: years in a left gutter, ruled headings, full numbered publication lists, running footer with name and page numbers.",
  "recommended_modes": [
    "academic_cv",
    "scientific_research"
  ],
  "page": {
    "margin_top_mm": 18,
    "margin_bottom_mm": 18,
    "margin_left_mm": 20,
    "margin_right_mm": 20
  },
  "fonts": {
    "body": "Cambria",
    "heading": "Cambria",
    "name": "Cambria",
    "body_size": 10.5,
    "heading_size": 12,
    "name_size": 20,
    "headline_size": 11,
    "small_size": 9,
    "line_spacing": 1.08
  },
  "colours": {
    "text": "#1A1A1A",
    "muted": "#4A4A4A",
    "accent": "#1D3557",
    "rule": "#1D3557",
    "fill": "#EEF1F6",
    "banner_fill": "#1D3557",
    "banner_text": "#FFFFFF",
    "sidebar_fill": "#F2F4F8",
    "link": "#1D3557"
  },
  "header": {
    "style": "centered",
    "name_case": "normal",
    "name_colour": "text",
    "headline_colour": "muted",
    "contact_style": "stacked",
    "separator": "  ·  ",
    "rule": "single"
  },
  "heading": {
    "style": "rule_below",
    "case": "title",
    "colour": "accent",
    "letter_spacing": 0,
    "space_before": 12,
    "space_after": 5,
    "rule_weight": 0.6
  },
  "entry": {
    "style": "date_left",
    "date_style": "year",
    "subtitle_italic": true,
    "gutter_mm": 24
  },
  "skills": {
    "style": "inline_categories",
    "competencies_style": "inline"
  },
  "publications": {
    "style": "numbered",
    "highlight_name": true
  },
  "footer": {
    "page_numbers": "page_x_of_y",
    "show_name": true,
    "text": "Curriculum Vitae"
  }
}
