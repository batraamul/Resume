{
  "id": "clean_two_column",
  "name": "Clean Two-Column",
  "version": "1.0.0",
  "family": "two-column sidebar",
  "description": "Balanced two-column resume: experience and projects in the wide column, with skills, education, training and languages in a light sidebar at the right.",
  "recommended_modes": [
    "general_professional",
    "technical_specialist"
  ],
  "page": {
    "margin_top_mm": 14,
    "margin_bottom_mm": 14,
    "margin_left_mm": 15,
    "margin_right_mm": 15
  },
  "fonts": {
    "body": "Calibri",
    "heading": "Calibri",
    "name": "Calibri",
    "body_size": 10,
    "heading_size": 11.5,
    "name_size": 23,
    "headline_size": 11,
    "small_size": 9,
    "line_spacing": 1.08
  },
  "colours": {
    "text": "#1E1E1E",
    "muted": "#4A4F57",
    "accent": "#2F4858",
    "rule": "#2F4858",
    "fill": "#EEF2F7",
    "banner_fill": "#2F4858",
    "banner_text": "#FFFFFF",
    "sidebar_fill": "#F3F5F7",
    "link": "#2F4858"
  },
  "header": {
    "style": "left",
    "name_case": "upper",
    "name_colour": "accent",
    "headline_colour": "muted",
    "separator": "  ·  ",
    "rule": "single"
  },
  "heading": {
    "style": "rule_below",
    "case": "upper",
    "colour": "accent",
    "letter_spacing": 0.8,
    "space_before": 9,
    "space_after": 3
  },
  "entry": {
    "style": "stacked",
    "date_style": "mon_year",
    "subtitle_italic": true
  },
  "skills": {
    "style": "bullets",
    "competencies_style": "bullets"
  },
  "columns": {
    "enabled": true,
    "side": "right",
    "width_frac": 0.31,
    "gap_mm": 7,
    "sidebar_sections": [
      "skills",
      "competencies",
      "education",
      "training",
      "languages"
    ]
  },
  "footer": {
    "page_numbers": "x_of_y",
    "show_name": true
  }
}
