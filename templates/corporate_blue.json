{
  "id": "corporate_blue",
  "name": "Corporate Blue",
  "version": "1.0.0",
  "family": "single-column plain",
  "description": "Clean corporate resume with a blue accent bar beside each heading and right-aligned dates. Works for most public and private sector applications. Single column and ATS-safe.",
  "recommended_modes": [
    "general_professional",
    "ats_plain"
  ],
  "ats_safe": true,
  "tables_allowed": false,
  "page": {
    "margin_top_mm": 15,
    "margin_bottom_mm": 15,
    "margin_left_mm": 19,
    "margin_right_mm": 19
  },
  "fonts": {
    "body": "Calibri",
    "heading": "Calibri",
    "name": "Calibri",
    "body_size": 10.5,
    "heading_size": 11.5,
    "name_size": 22,
    "headline_size": 11,
    "small_size": 9,
    "line_spacing": 1.08
  },
  "colours": {
    "text": "#1E1E1E",
    "muted": "#4A4F57",
    "accent": "#1D4E89",
    "rule": "#1D4E89",
    "fill": "#EEF2F7",
    "banner_fill": "#1D4E89",
    "banner_text": "#FFFFFF",
    "sidebar_fill": "#F2F4F8",
    "link": "#1D4E89"
  },
  "header": {
    "style": "left",
    "name_case": "normal",
    "name_colour": "accent",
    "headline_colour": "text",
    "separator": "  |  ",
    "rule": "single"
  },
  "heading": {
    "style": "left_bar",
    "case": "upper",
    "colour": "accent",
    "space_before": 10,
    "space_after": 4
  },
  "entry": {
    "style": "title_date_right",
    "date_style": "mon_year",
    "subtitle_italic": true
  },
  "skills": {
    "style": "inline_categories",
    "competencies_style": "inline"
  },
  "footer": {
    "page_numbers": "x_of_y",
    "show_name": true
  }
}
