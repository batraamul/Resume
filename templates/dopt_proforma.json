{
  "id": "dopt_proforma",
  "name": "DoPT Deputation Proforma",
  "version": "1.0.0",
  "family": "formal tabular proforma",
  "description": "Bio-data / CV proforma for deputation applications (DoPT OM dated 02.07.2015): items 1–18 in ruled tables with the item wording, the candidate's declaration and the employer's certificate. Black on white, Times New Roman 11 pt, for printing, signing and forwarding through proper channel.",
  "recommended_modes": [
    "deputation_proforma",
    "government_biodata"
  ],
  "page": {
    "margin_top_mm": 16,
    "margin_bottom_mm": 16,
    "margin_left_mm": 20,
    "margin_right_mm": 16
  },
  "fonts": {
    "body": "Times New Roman",
    "heading": "Times New Roman",
    "name": "Times New Roman",
    "body_size": 11,
    "heading_size": 11.5,
    "name_size": 13,
    "headline_size": 11,
    "small_size": 9.5,
    "line_spacing": 1.06
  },
  "colours": {
    "text": "#000000",
    "muted": "#222222",
    "accent": "#000000",
    "rule": "#000000",
    "fill": "#E7E7E7",
    "banner_fill": "#000000",
    "banner_text": "#FFFFFF",
    "sidebar_fill": "#FFFFFF",
    "link": "#000000"
  },
  "header": {
    "style": "centered",
    "name_case": "upper",
    "name_colour": "text",
    "headline_colour": "text",
    "contact_style": "inline",
    "separator": "  |  ",
    "rule": "none"
  },
  "heading": {
    "style": "plain_bold",
    "case": "title",
    "colour": "text",
    "letter_spacing": 0,
    "space_before": 10,
    "space_after": 4
  },
  "entry": {
    "style": "title_date_right",
    "date_style": "mm_yyyy",
    "subtitle_italic": false
  },
  "skills": {
    "style": "inline_categories",
    "competencies_style": "inline"
  },
  "publications": {
    "style": "numbered",
    "highlight_name": false
  },
  "photo": {
    "allowed": true,
    "width_mm": 30
  },
  "footer": {
    "page_numbers": "page_x_of_y",
    "show_name": true
  }
}
