{
  "id": "executive_technical",
  "name": "Executive Technical",
  "version": "1.0.0",
  "family": "centered classic",
  "description": "Senior technical leadership: centred serif name in small capitals over a double rule, letter-spaced section headings, three-column areas of expertise.",
  "recommended_modes": [
    "executive_summary",
    "general_professional"
  ],
  "summary_style": "italic",
