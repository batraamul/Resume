    "margin_top_mm": 15,
    "margin_bottom_mm": 15,
    "margin_left_mm": 19,
    "margin_right_mm": 19
  },
  "fonts": {
    "body": "Calibri",
    "heading": "Cambria",
    "name": "Cambria",
    "body_size": 10.5,
    "heading_size": 11,
    "name_size": 24,
    "headline_size": 11.5,
    "small_size": 9,
    "line_spacing": 1.08
  },
  "colours": {
    "text": "#1E1E1E",
    "muted": "#4A4F57",
    "accent": "#1F3A5F",
    "rule": "#1F3A5F",
    "fill": "#EEF2F7",
    "banner_fill": "#1F3A5F",
    "banner_text": "#FFFFFF",
    "sidebar_fill": "#F2F4F8",
    "link": "#1F3A5F"
