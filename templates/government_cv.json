{
  "id": "government_cv",
  "name": "Government CV",
  "version": "1.0.0",
  "family": "formal tabular bio-data",
  "description": "Government bio-data style: title line, numbered headings, ruled tables for particulars, qualifications, employment and the requirements-versus-possessed matrix, and a signed declaration. Always follow the exact proforma prescribed in the circular.",
  "recommended_modes": [
    "government_biodata"
  ],
  "page": {
    "margin_top_mm": 18,
    "margin_bottom_mm": 18,
    "margin_left_mm": 20,
    "margin_right_mm": 18
  },
  "fonts": {
    "body": "Times New Roman",
    "heading": "Times New Roman",
    "name": "Times New Roman",
    "body_size": 11,
    "heading_size": 11.5,
    "name_size": 14,
    "headline_size": 11,
    "small_size": 9.5,
    "line_spacing": 1.08
  },
  "colours": {
    "text": "#000000",
    "muted": "#222222",
    "accent": "#000000",
    "rule": "#000000",
    "fill": "#E7E7E7",
    "banner_fill": "#000000",
    "banner_text": "#FFFFFF",
    "sidebar_fill": "#FFFFFF",
    "link": "#000000"
  },
  "header": {
    "style": "centered",
    "name_case": "upper",
    "name_colour": "text",
    "headline_colour": "text",
    "contact_style": "inline",
    "separator": "  |  ",
    "rule": "none"
  },
  "heading": {
    "style": "numbered",
    "case": "upper",
    "colour": "text",
    "letter_spacing": 0,
    "space_before": 11,
    "space_after": 4
  },
  "entry": {
    "style": "title_date_right",
    "date_style": "mm_yyyy",
    "subtitle_italic": false
  },
  "skills": {
    "style": "inline_categories",
    "competencies_style": "inline"
  },
  "publications": {
    "style": "numbered",
    "highlight_name": false
  },
  "photo": {
    "allowed": true,
    "width_mm": 30
  },
  "footer": {
    "page_numbers": "page_x_of_y",
    "show_name": false
  }
}
