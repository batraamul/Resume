{
  "id": "graphical_executive",
  "name": "Graphical Executive",
  "version": "1.0.0",
  "family": "graphical",
  "description": "Visual leadership profile for interview boards and networking: banner header, career timeline, publication charts and skill bars. Not for online portals.",
  "recommended_modes": [
    "graphical_profile",
    "senior_graphical"
  ],
  "page": {
    "margin_top_mm": 13,
    "margin_bottom_mm": 13,
    "margin_left_mm": 15,
    "margin_right_mm": 15
  },
  "fonts": {
    "body": "Calibri",
    "heading": "Calibri",
    "name": "Calibri",
    "body_size": 10,
    "heading_size": 11.5,
    "name_size": 24,
    "headline_size": 11,
    "small_size": 9,
    "line_spacing": 1.08
  },
  "colours": {
    "text": "#1E1E1E",
    "muted": "#4A4F57",
    "accent": "#12355B",
    "rule": "#12355B",
    "fill": "#E8EEF5",
    "banner_fill": "#12355B",
    "banner_text": "#FFFFFF",
    "sidebar_fill": "#EEF2F7",
    "link": "#12355B"
  },
  "header": {
    "style": "banner",
    "name_case": "upper",
    "name_colour": "text",
    "headline_colour": "text",
    "contact_icons": true,
    "separator": "    ",
    "rule": "none"
  },
  "heading": {
    "style": "shaded_bar",
    "case": "upper",
    "colour": "accent",
    "letter_spacing": 0.8,
    "space_before": 9,
    "space_after": 4
  },
  "entry": {
    "style": "title_date_right",
    "date_style": "mon_year",
    "subtitle_italic": false,
    "project_style": "cards"
  },
  "skills": {
    "style": "bars",
    "competencies_style": "columns",
    "columns": 3
  },
  "graphics": {
    "enabled": true,
    "palette": [
      "#12355B",
      "#420039",
      "#D72638",
      "#F49D37",
      "#3F88C5",
      "#2E7D5B"
    ],
    "timeline_height_mm": 54,
    "bar_width_mm": 30
  },
  "footer": {
    "page_numbers": "x_of_y",
    "show_name": true
  }
}
