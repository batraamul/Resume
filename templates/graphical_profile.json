{
  "id": "graphical_profile",
  "name": "Graphical Career Profile",
  "version": "1.0.0",
  "family": "framed banner, sidebar bars, timeline chart",
  "description": "Designed profile in the style of a government officer's graphical CV: framed name banner with contact icons, shaded summary band, areas-of-expertise table, a career timeline chart with legend, and self-assessed competency bars in the right sidebar.",
  "recommended_modes": [
    "graphical_profile",
    "defence_technical",
    "project_portfolio"
  ],
  "summary_style": "boxed",
  "page": {
    "margin_top_mm": 12,
    "margin_bottom_mm": 14,
    "margin_left_mm": 14,
    "margin_right_mm": 14
  },
  "fonts": {
    "body": "Calibri",
    "heading": "Cambria",
    "name": "Cambria",
    "body_size": 9.8,
    "heading_size": 12,
    "name_size": 22,
    "headline_size": 10.5,
    "small_size": 8.6,
    "line_spacing": 1.08
  },
  "colours": {
    "text": "#1C2321",
    "muted": "#4D5955",
    "accent": "#145A47",
    "rule": "#9DB4AC",
    "fill": "#E6E9E8",
    "banner_fill": "#11806A",
    "banner_text": "#FFFFFF",
    "banner_outer": "#151A19",
    "sidebar_fill": "#F2F5F4",
    "link": "#145A47",
    "tile_fill": "#EAF2EF",
    "bar_track": "#CFDAD6"
  },
  "header": {
    "style": "framed",
    "name_case": "upper",
    "name_colour": "text",
    "headline_colour": "text",
    "contact_style": "inline",
    "contact_icons": true,
    "separator": "     ",
    "rule": "none"
  },
  "heading": {
    "style": "plain_bold",
    "case": "upper",
    "colour": "accent",
    "letter_spacing": 0.4,
    "space_before": 11,
    "space_after": 4,
    "rule_weight": 0.75
  },
  "entry": {
    "style": "title_date_right",
    "date_style": "mon_year",
    "subtitle_italic": true,
    "bullet_glyph": "➢",
    "project_style": "standard"
  },
  "skills": {
    "style": "bars",
    "competencies_style": "bullets"
  },
  "columns": {
    "enabled": true,
    "side": "right",
    "width_frac": 0.31,
    "gap_mm": 6,
    "sidebar_sections": [
      "skills",
      "competencies",
      "training",
      "languages"
    ]
  },
  "graphics": {
    "enabled": true,
    "palette": ["#0F6E5C", "#2F4F1E", "#123E63", "#159A7D", "#8E1B1B", "#6B4C9A", "#B5651D"],
    "timeline_height_mm": 54,
    "bar_width_mm": 30
  },
  "footer": {
    "page_numbers": "x",
    "show_name": true
  }
}
