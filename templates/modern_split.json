{
  "id": "modern_split",
  "name": "Modern Split Header",
  "version": "1.0.0",
  "family": "split header",
  "description": "Modern layout with the name at the left and contact details stacked at the right, teal accent bars beside each heading and a skills table.",
  "recommended_modes": [
    "general_professional",
    "technical_specialist",
    "project_portfolio"
  ],
  "page": {
    "margin_top_mm": 15,
    "margin_bottom_mm": 15,
    "margin_left_mm": 18,
    "margin_right_mm": 18
  },
  "fonts": {
    "body": "Calibri",
    "heading": "Calibri",
    "name": "Calibri",
    "body_size": 10.5,
    "heading_size": 11.5,
    "name_size": 24,
    "headline_size": 11,
    "small_size": 9,
    "line_spacing": 1.08
  },
  "colours": {
    "text": "#1E1E1E",
    "muted": "#4A4F57",
    "accent": "#0F6E6E",
    "rule": "#0F6E6E",
    "fill": "#E6F2F2",
    "banner_fill": "#0F6E6E",
    "banner_text": "#FFFFFF",
    "sidebar_fill": "#F2F4F8",
    "link": "#0F6E6E"
  },
  "header": {
    "style": "split",
    "name_case": "normal",
    "name_colour": "accent",
    "headline_colour": "text",
    "contact_style": "stacked",
    "separator": " | ",
    "rule": "single"
  },
  "heading": {
    "style": "left_bar",
    "case": "title",
    "colour": "accent",
    "space_before": 11,
    "space_after": 4
  },
  "entry": {
    "style": "title_date_right",
    "date_style": "mon_year",
    "subtitle_italic": false
  },
  "skills": {
    "style": "table",
    "competencies_style": "inline"
  },
  "footer": {
    "page_numbers": "x_of_y",
    "show_name": true
  }
}
