{
  "id": "programme_manager",
  "name": "Programme Manager",
  "version": "1.0.0",
  "family": "banner",
  "description": "Delivery-focused resume for programme and project managers: slate banner header, project cards and competencies in four columns.",
  "recommended_modes": [
    "project_portfolio",
    "general_professional",
    "technical_specialist"
  ],
  "page": {
    "margin_top_mm": 14,
    "margin_bottom_mm": 14,
    "margin_left_mm": 17,
    "margin_right_mm": 17
  },
  "fonts": {
    "body": "Calibri",
    "heading": "Calibri",
    "name": "Calibri",
    "body_size": 10.5,
    "heading_size": 11.5,
    "name_size": 24,
    "headline_size": 11,
    "small_size": 9,
    "line_spacing": 1.08
  },
  "colours": {
    "text": "#1E1E1E",
    "muted": "#4A4F57",
    "accent": "#37474F",
    "rule": "#37474F",
    "fill": "#ECEFF1",
    "banner_fill": "#37474F",
    "banner_text": "#FFFFFF",
    "sidebar_fill": "#F2F4F8",
    "link": "#37474F"
  },
  "header": {
    "style": "banner",
    "name_case": "normal",
    "name_colour": "text",
    "headline_colour": "text",
    "separator": "  |  ",
    "rule": "none"
  },
  "heading": {
    "style": "caps_rule",
    "case": "upper",
    "colour": "accent",
    "letter_spacing": 1.0,
    "space_before": 10,
    "space_after": 4
  },
  "entry": {
    "style": "title_date_right",
    "date_style": "mon_year",
    "subtitle_italic": true,
    "project_style": "cards"
  },
  "skills": {
    "style": "inline_categories",
    "competencies_style": "columns",
    "columns": 4
  },
  "footer": {
    "page_numbers": "x_of_y",
    "show_name": true
  }
}
